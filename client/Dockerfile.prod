# Built from the repo root (see docker-compose.prod.yml), like the backend, so the
# shared Tab model in `shared/` is in the build context. The client imports it as
# @tablab/shared and Vite resolves that to ../shared — /app/shared next to /app/client.
# Node 22 and the pinned pnpm match Dockerfile.dev: pnpm 11, the "packageManager" in
# package.json, needs Node >= 22.13 and fails to start on Node 20.
FROM node:22-alpine AS builder
WORKDIR /app/client
RUN corepack enable && corepack prepare pnpm@11.25.0 --activate
# pnpm-workspace.yaml must be present at install time: it carries the build-script
# approvals (without them pnpm fails on esbuild) and the security overrides.
COPY client/package.json client/pnpm-lock.yaml* client/pnpm-workspace.yaml* ./
RUN pnpm install
COPY shared/ /app/shared/
COPY client/ ./
ARG VITE_BE_URL
ENV VITE_BE_URL=$VITE_BE_URL
RUN pnpm run build

FROM nginx:alpine
COPY --from=builder /app/client/dist /usr/share/nginx/html
COPY client/nginx.client.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
